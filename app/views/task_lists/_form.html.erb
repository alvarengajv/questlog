<div data-controller="color-picker">
  <%= form_with(model: task_list, id: dom_id(task_list, "form"), class: "quest-card p-4 space-y-3", data: { color_picker_target: "card" }, style: task_list.color.present? ? "border-color: #{task_list.color};" : nil) do |form| %>
    <div class="flex items-center gap-2">
      <%= form.label :color, "Cor da lista", class: "sr-only" %>
      <%= form.color_field :color, class: "w-7 h-7 rounded-lg border border-[rgba(201,169,110,0.2)] bg-transparent cursor-pointer flex-shrink-0", value: task_list.color.presence || "#C9A96E", aria: { label: "Cor da lista" }, data: { color_picker_target: "picker", action: "input->color-picker#pick" } %>
      <%= form.label :title, "Nome da lista", class: "sr-only" %>
      <%= form.text_field :title, class: "quest-input text-sm flex-1", placeholder: "Criar nova lista..." %>
    </div>
    <%= form.submit task_list.new_record? ? "Criar lista" : "Salvar", class: "quest-btn w-full text-xs" %>
  <% end %>
</div>
