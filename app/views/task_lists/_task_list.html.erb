<div id="<%= dom_id(task_list) %>" class="quest-card p-5 flex flex-col">
  <%# Header with color accent %>
  <div class="flex items-start justify-between mb-3">
    <div class="flex items-center gap-2.5">
      <% if task_list.color.present? %>
        <div class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: <%= task_list.color %>; box-shadow: 0 0 8px <%= task_list.color %>40;"></div>
      <% end %>
      <%= link_to task_list_path(task_list), class: "font-display font-semibold text-[var(--color-parchment)] hover:text-[var(--color-quest-gold)] transition-colors tracking-wide" do %>
        <%= task_list.title %>
      <% end %>
    </div>
  </div>

  <%# Progress %>
  <div class="mt-auto">
    <div class="flex justify-between items-center text-xs text-[var(--color-quest-gold-dim)] mb-1.5">
      <span><%= task_list.items.completed.count %>/<%= task_list.items.count %> itens</span>
      <span><%= task_list.progress_percentage %>%</span>
    </div>
    <%= render "shared/xp_progress", percentage: task_list.progress_percentage %>
  </div>

  <%# Actions %>
  <div class="flex items-center gap-2 mt-3 pt-3 border-t border-[rgba(201,169,110,0.08)]">
    <% if task_list.active? %>
      <%= button_to archive_task_list_path(task_list), method: :patch, class: "text-xs text-[var(--color-quest-gold-dim)] hover:text-[var(--color-quest-gold)] transition-colors cursor-pointer bg-transparent border-0" do %>
        Arquivar
      <% end %>
    <% else %>
      <%= button_to restore_task_list_path(task_list), method: :patch, class: "text-xs text-[var(--color-forest-sage)] hover:text-[#94B974] transition-colors cursor-pointer bg-transparent border-0" do %>
        Restaurar
      <% end %>
    <% end %>
    <%= button_to task_list_path(task_list), method: :delete, class: "text-xs text-[var(--color-critical-hit)]/60 hover:text-[var(--color-critical-hit)] transition-colors cursor-pointer bg-transparent border-0 ml-auto", data: { turbo_confirm: "Remover esta quest?" } do %>
      Remover
    <% end %>
  </div>
</div>
