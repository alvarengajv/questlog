<%# === HEADER === %>
<div class="mb-6">
  <h1 class="text-3xl font-bold tracking-wide">Quest Board</h1>
</div>

<%# === BOARD: horizontal scrolling columns like Google Tasks === %>
<div class="flex gap-4 overflow-x-auto pb-4 -mx-4 px-4 h-[calc(100vh-10rem)] md:h-[calc(100vh-6rem)] items-start board-scroll">

  <% @active_lists.each do |task_list| %>
    <div id="<%= dom_id(task_list) %>" class="flex-shrink-0 w-72 quest-card flex flex-col max-h-full">
      <%# Column header %>
      <div class="px-4 py-3 border-b border-[rgba(201,169,110,0.08)] flex items-center justify-between">
        <div class="flex items-center gap-2 min-w-0">
          <% if task_list.color.present? %>
            <div class="w-2.5 h-2.5 rounded-full flex-shrink-0" style="background-color: <%= task_list.color %>;"></div>
          <% end %>
          <%= link_to task_list_path(task_list), class: "font-display font-semibold text-sm text-[var(--color-parchment)] hover:text-[var(--color-quest-gold)] transition-colors tracking-wide truncate" do %>
            <%= task_list.title %>
          <% end %>
        </div>
        <div class="flex items-center gap-1 flex-shrink-0">
          <%= button_to archive_task_list_path(task_list), method: :patch, class: "p-1 text-[var(--color-quest-gold-dim)]/40 hover:text-[var(--color-quest-gold-dim)] transition-colors bg-transparent border-0 cursor-pointer", aria: { label: "Arquivar lista" } do %>
            <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
            </svg>
          <% end %>
          <%= button_to task_list_path(task_list), method: :delete, class: "p-1 text-[var(--color-quest-gold-dim)]/40 hover:text-[var(--color-critical-hit)] transition-colors bg-transparent border-0 cursor-pointer", aria: { label: "Remover lista" }, data: { turbo_confirm: "Remover esta lista?" } do %>
            <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
          <% end %>
        </div>
      </div>

      <%# Add item button %>
      <div class="px-4 py-2 border-b border-[rgba(201,169,110,0.06)]">
        <%= form_with(model: [task_list, Item.new], class: "flex items-center gap-2") do |f| %>
          <%= f.label :content, "Nova tarefa", class: "sr-only" %>
          <%= f.text_field :content, class: "quest-input text-xs py-1.5 flex-1", placeholder: "Adicionar uma tarefa..." %>
          <%= f.hidden_field :priority, value: "low" %>
          <%= f.submit "+", class: "w-7 h-7 rounded-md bg-[rgba(201,169,110,0.1)] text-[var(--color-quest-gold)] hover:bg-[rgba(201,169,110,0.2)] transition-colors text-sm font-bold cursor-pointer border-0 flex-shrink-0", aria: { label: "Adicionar tarefa" } %>
        <% end %>
      </div>

      <%# Items list (scrollable) %>
      <div class="flex-1 overflow-y-auto px-1 py-1">
        <%
          pending_items = task_list.items.select(&:pending?)
          completed_items = task_list.items.select(&:completed?)
          overdue_items = pending_items.select(&:overdue?)
          dated_items = pending_items.select { |i| i.due_date.present? && !i.overdue? }
          undated_items = pending_items.select { |i| i.due_date.nil? }
        %>

        <%# Overdue items %>
        <% if overdue_items.any? %>
          <p class="px-3 pt-2.5 pb-1 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-critical-hit)]">Atrasadas</p>
          <% overdue_items.each do |item| %>
            <%= render partial: "items/board_item", locals: { item: item } %>
          <% end %>
        <% end %>

        <%# Dated items (upcoming) %>
        <% if dated_items.any? %>
          <p class="px-3 pt-2.5 pb-1 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-quest-gold-dim)]">Com prazo</p>
          <% dated_items.sort_by(&:due_date).each do |item| %>
            <%= render partial: "items/board_item", locals: { item: item } %>
          <% end %>
        <% end %>

        <%# Undated items %>
        <% if undated_items.any? %>
          <p class="px-3 pt-2.5 pb-1 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-quest-gold-dim)]">Sem data</p>
          <% undated_items.each do |item| %>
            <%= render partial: "items/board_item", locals: { item: item } %>
          <% end %>
        <% end %>

        <%# Empty state %>
        <% if pending_items.empty? %>
          <div class="px-3 py-6 text-center">
            <p class="text-[var(--color-quest-gold-dim)]/40 text-xs">Nenhuma tarefa pendente</p>
          </div>
        <% end %>

        <%# Completed items (collapsible) %>
        <% if completed_items.any? %>
          <details class="group mt-1">
            <summary class="flex items-center gap-1.5 cursor-pointer text-[var(--color-quest-gold-dim)]/60 hover:text-[var(--color-quest-gold-dim)] transition-colors text-xs px-3 py-2">
              <svg class="w-3 h-3 transition-transform group-open:rotate-90" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
              Concluídas (<%= completed_items.size %>)
            </summary>
            <div class="pb-1">
              <% completed_items.each do |item| %>
                <%= render partial: "items/board_item", locals: { item: item } %>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# === NEW LIST COLUMN === %>
  <div class="flex-shrink-0 w-72">
    <div id="new_task_list_form">
      <%= render "form", task_list: TaskList.new %>
    </div>
  </div>
</div>

<%# === ARCHIVED LISTS (below board) === %>
<% if @archived_lists.any? %>
  <div class="mt-4">
    <details class="group">
      <summary class="flex items-center gap-2 cursor-pointer text-[var(--color-quest-gold-dim)]/50 hover:text-[var(--color-quest-gold-dim)] transition-colors text-xs font-medium">
        <svg class="w-3 h-3 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
        Listas arquivadas (<%= @archived_lists.size %>)
      </summary>
      <div id="archived_task_lists" class="flex gap-3 overflow-x-auto pt-3 pb-2">
        <% @archived_lists.each do |task_list| %>
          <div id="<%= dom_id(task_list) %>" class="flex-shrink-0 quest-card px-4 py-3 w-56 flex items-center justify-between">
            <span class="text-sm text-[var(--color-quest-gold-dim)] truncate"><%= task_list.title %></span>
            <%= button_to restore_task_list_path(task_list), method: :patch, class: "text-[10px] text-[var(--color-forest-sage)] hover:text-[#94B974] transition-colors cursor-pointer bg-transparent border-0 flex-shrink-0" do %>
              Restaurar
            <% end %>
          </div>
        <% end %>
      </div>
    </details>
  </div>
<% end %>
