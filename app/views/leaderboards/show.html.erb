<%# === HEADER === %>
<div class="mb-6 sm:mb-8">
  <h1 class="text-2xl sm:text-3xl font-bold tracking-wide">Ranking</h1>
</div>

<%# === LEADERBOARD === %>
<div class="quest-card p-4 sm:p-6">
  <% if @rankings.any? %>
    <%# Mobile: card layout %>
    <div class="sm:hidden space-y-2">
      <% @rankings.each_with_index do |user, index| %>
        <% position = index + 1 %>
        <div class="flex items-center gap-3 rounded-lg px-3 py-3 <%= user.id == @current_user_id ? 'bg-[rgba(201,169,110,0.08)] border border-[var(--border-default)]' : 'bg-[rgba(28,23,18,0.5)]' %>">
          <div class="w-8 text-center flex-shrink-0">
            <% if position == 1 %>
              <span class="text-lg">&#x1F947;</span>
            <% elsif position == 2 %>
              <span class="text-lg">&#x1F948;</span>
            <% elsif position == 3 %>
              <span class="text-lg">&#x1F949;</span>
            <% else %>
              <span class="text-sm text-[var(--color-quest-gold-dim)] font-semibold"><%= position %></span>
            <% end %>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold truncate <%= user.id == @current_user_id ? 'text-[var(--color-quest-gold)]' : 'text-[var(--color-parchment)]' %>"><%= user.name %></p>
            <div class="flex items-center gap-3 mt-0.5">
              <span class="text-xs text-[var(--color-mana-blue)] font-display font-bold">Lv.<%= user.level %></span>
              <span class="text-xs text-[var(--color-quest-gold)] font-semibold tabular-nums"><%= user.xp %> XP</span>
              <span class="text-xs text-[var(--color-xp-amber)] tabular-nums"><%= user.streak_days %> &#x1F525;</span>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <%# Desktop: table layout %>
    <div class="hidden sm:block overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-[var(--border-default)]">
            <th class="text-left py-3 px-3 text-[10px] text-[var(--color-quest-gold-dim)] uppercase tracking-widest font-semibold">#</th>
            <th class="text-left py-3 px-3 text-[10px] text-[var(--color-quest-gold-dim)] uppercase tracking-widest font-semibold">Aventureiro</th>
            <th class="text-center py-3 px-3 text-[10px] text-[var(--color-quest-gold-dim)] uppercase tracking-widest font-semibold">Nível</th>
            <th class="text-center py-3 px-3 text-[10px] text-[var(--color-quest-gold-dim)] uppercase tracking-widest font-semibold">XP</th>
            <th class="text-center py-3 px-3 text-[10px] text-[var(--color-quest-gold-dim)] uppercase tracking-widest font-semibold">Streak</th>
          </tr>
        </thead>
        <tbody>
          <% @rankings.each_with_index do |user, index| %>
            <% position = index + 1 %>
            <tr class="border-b border-[var(--border-subtle)] <%= 'bg-[rgba(201,169,110,0.05)]' if user.id == @current_user_id %>">
              <td class="py-3 px-3">
                <% if position == 1 %>
                  <span class="text-lg">&#x1F947;</span>
                <% elsif position == 2 %>
                  <span class="text-lg">&#x1F948;</span>
                <% elsif position == 3 %>
                  <span class="text-lg">&#x1F949;</span>
                <% else %>
                  <span class="text-[var(--color-quest-gold-dim)]"><%= position %></span>
                <% end %>
              </td>
              <td class="py-3 px-3">
                <span class="font-semibold text-[var(--color-parchment)] <%= 'text-[var(--color-quest-gold)]' if user.id == @current_user_id %>">
                  <%= user.name %>
                </span>
              </td>
              <td class="py-3 px-3 text-center">
                <span class="font-display font-bold text-[var(--color-mana-blue)]"><%= user.level %></span>
              </td>
              <td class="py-3 px-3 text-center">
                <span class="font-semibold text-[var(--color-quest-gold)] tabular-nums"><%= user.xp %></span>
              </td>
              <td class="py-3 px-3 text-center">
                <span class="text-[var(--color-xp-amber)] tabular-nums"><%= user.streak_days %> &#x1F525;</span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="quest-empty-state">
      <div class="quest-empty-state-icon">&#x1F3C6;</div>
      <p class="quest-empty-state-text">Nenhum aventureiro no ranking ainda.</p>
    </div>
  <% end %>
</div>
