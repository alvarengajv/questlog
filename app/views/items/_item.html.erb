<div id="<%= dom_id(item) %>" class="quest-card px-4 py-3 flex items-center gap-3 group item-enter <%= item.completed? ? 'opacity-50' : '' %>">
  <%# Drag handle %>
  <% unless item.completed? %>
    <div data-sortable-handle class="cursor-grab active:cursor-grabbing text-[var(--color-quest-gold-dim)] hover:text-[var(--color-quest-gold)] transition-colors flex-shrink-0 opacity-0 group-hover:opacity-100">
      <svg class="w-4 h-4" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24">
        <circle cx="9" cy="5" r="1.5"/><circle cx="15" cy="5" r="1.5"/>
        <circle cx="9" cy="12" r="1.5"/><circle cx="15" cy="12" r="1.5"/>
        <circle cx="9" cy="19" r="1.5"/><circle cx="15" cy="19" r="1.5"/>
      </svg>
    </div>
  <% end %>

  <%# Toggle checkbox %>
  <%= button_to toggle_task_list_item_path(item.task_list, item), method: :patch, class: "bg-transparent border-0 p-0 cursor-pointer flex-shrink-0", aria: { label: item.completed? ? "Marcar como pendente" : "Marcar como concluída" } do %>
    <div class="w-5 h-5 rounded border-2 flex items-center justify-center transition-all
      <%= item.completed? ? 'bg-[var(--color-forest-sage)] border-[var(--color-forest-sage)]' : 'border-[rgba(201,169,110,0.3)] hover:border-[var(--color-quest-gold)] hover:shadow-[0_0_8px_rgba(201,169,110,0.15)]' %>">
      <% if item.completed? %>
        <svg class="w-3 h-3 text-white" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
      <% end %>
    </div>
  <% end %>

  <%# Content %>
  <div class="flex-1 min-w-0">
    <span class="text-sm <%= item.completed? ? 'line-through text-[var(--color-quest-gold-dim)]' : 'text-[var(--color-aged-linen)]' %>">
      <%= item.content %>
    </span>
    <% if item.due_date.present? %>
      <span class="text-xs ml-2 <%= due_date_class(item) %>">
        <%= item.due_date.strftime("%d/%m") %>
      </span>
    <% end %>
  </div>

  <%# Badges %>
  <div class="flex items-center gap-2">
    <%= priority_badge(item) %>
    <%= recurrence_badge(item) %>

    <%# Menu dropdown %>
    <details class="relative opacity-0 group-hover:opacity-100 transition-opacity">
      <summary class="list-none cursor-pointer p-1 text-[var(--color-quest-gold-dim)] hover:text-[var(--color-quest-gold)] transition-colors" aria-label="Menu de opções">
        <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v.01M12 12v.01M12 19v.01"/>
        </svg>
      </summary>
      <div class="absolute right-0 top-full mt-1 z-10 quest-card py-1 min-w-[140px] shadow-xl">
        <%= link_to edit_task_list_item_path(item.task_list, item), class: "flex items-center gap-2 px-3 py-2 text-sm text-[var(--color-aged-linen)] hover:bg-[rgba(201,169,110,0.08)] transition-colors" do %>
          <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
          Editar
        <% end %>
        <%= button_to task_list_item_path(item.task_list, item), method: :delete, class: "flex items-center gap-2 px-3 py-2 text-sm text-[var(--color-critical-hit)] hover:bg-[rgba(184,76,58,0.08)] transition-colors w-full text-left", data: { turbo_confirm: "Remover este item?" } do %>
          <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
          Excluir
        <% end %>
      </div>
    </details>
  </div>
</div>
