<div class="min-h-[70vh] flex items-center justify-center">
  <div class="w-full max-w-sm">
    <%# Logo %>
    <div class="text-center mb-8">
      <img src="/questlog_logo_w_text.svg" alt="QuestLog" class="h-14 mx-auto mb-4 opacity-80">
      <h1 class="text-2xl font-bold tracking-wide">Criar Conta</h1>
      <p class="text-[var(--color-quest-gold-dim)] text-sm mt-1">Comece sua aventura</p>
    </div>

    <div class="quest-card p-6">
      <%= form_with(model: @user, url: signup_path, local: true, class: "space-y-5") do |f| %>
        <% if @user.errors.any? %>
          <div class="quest-flash-alert rounded-lg p-3 text-sm" role="alert">
            <p class="font-semibold mb-1"><%= pluralize(@user.errors.count, "erro", "erros") %>:</p>
            <ul class="list-disc ml-4 space-y-0.5 text-xs opacity-90">
              <% @user.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :email, "Email", class: "block text-xs font-medium text-[var(--color-quest-gold-dim)] uppercase tracking-wider mb-1.5" %>
          <%= f.email_field :email, class: "quest-input", placeholder: "seu@email.com", autocomplete: "email" %>
        </div>

        <div>
          <%= f.label :password, "Senha", class: "block text-xs font-medium text-[var(--color-quest-gold-dim)] uppercase tracking-wider mb-1.5" %>
          <%= f.password_field :password, class: "quest-input", placeholder: "••••••••", autocomplete: "new-password" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirmar Senha", class: "block text-xs font-medium text-[var(--color-quest-gold-dim)] uppercase tracking-wider mb-1.5" %>
          <%= f.password_field :password_confirmation, class: "quest-input", placeholder: "••••••••", autocomplete: "new-password" %>
        </div>

        <div class="pt-1">
          <%= f.submit "Criar Conta", class: "quest-btn w-full" %>
        </div>
      <% end %>
    </div>

    <p class="text-center text-sm text-[var(--color-quest-gold-dim)] mt-6">
      Já tem uma conta?
      <%= link_to "Entrar", login_path, class: "text-[var(--color-quest-gold)] hover:text-[var(--color-quest-gold-glow)] font-semibold transition-colors" %>
    </p>
  </div>
</div>
