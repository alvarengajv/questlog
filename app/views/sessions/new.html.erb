<div class="min-h-[70vh] flex items-center justify-center">
  <div class="w-full max-w-sm">
    <%# Logo %>
    <div class="text-center mb-8">
      <img src="/questlog_logo_w_text.svg" alt="QuestLog" class="h-14 mx-auto mb-4 opacity-80">
      <h1 class="text-2xl font-bold tracking-wide">Entrar</h1>
      <p class="text-[var(--color-quest-gold-dim)] text-sm mt-1">Retorne à sua jornada</p>
    </div>

    <div class="quest-card p-6">
      <%= form_with url: login_path, local: true, class: "space-y-5" do |f| %>
        <div>
          <%= f.label :email, "Email", class: "block text-xs font-medium text-[var(--color-quest-gold-dim)] uppercase tracking-wider mb-1.5" %>
          <%= f.email_field :email, class: "quest-input", placeholder: "seu@email.com", required: true, autocomplete: "email" %>
        </div>

        <div>
          <%= f.label :password, "Senha", class: "block text-xs font-medium text-[var(--color-quest-gold-dim)] uppercase tracking-wider mb-1.5" %>
          <%= f.password_field :password, class: "quest-input", placeholder: "••••••••", required: true, autocomplete: "current-password" %>
        </div>

        <div class="pt-1">
          <%= f.submit "Entrar", class: "quest-btn w-full" %>
        </div>
      <% end %>
    </div>

    <p class="text-center text-sm text-[var(--color-quest-gold-dim)] mt-6">
      Não tem uma conta?
      <%= link_to "Criar conta", signup_path, class: "text-[var(--color-quest-gold)] hover:text-[var(--color-quest-gold-glow)] font-semibold transition-colors" %>
    </p>
  </div>
</div>
