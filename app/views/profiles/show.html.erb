<div class="max-w-3xl mx-auto mt-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">Meu Perfil</h1>
    <%= link_to "Voltar", root_path, class: "text-blue-600 hover:text-blue-800 transition" %>
  </div>

  <div class="bg-white rounded-lg shadow-md p-6 mb-8">
    <div class="flex items-center gap-6 mb-8">
      <div class="w-24 h-24 bg-blue-100 rounded-full flex items-center justify-center text-blue-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </div>
      <div>
        <h2 class="text-2xl font-bold mb-1"><%= @profile.user.email %></h2>
        <p class="text-gray-600 text-lg flex items-center gap-2">
          <span class="inline-block w-4 h-4 bg-yellow-400 rounded-full"></span>
          <%= @profile.title %>
        </p>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
      <div class="bg-blue-50 p-4 rounded-lg text-center">
        <p class="text-sm text-gray-500 uppercase font-semibold mb-1">Nível</p>
        <p class="text-3xl font-bold text-blue-600"><%= @profile.level %></p>
      </div>
      <div class="bg-purple-50 p-4 rounded-lg text-center">
        <p class="text-sm text-gray-500 uppercase font-semibold mb-1">XP Total</p>
        <p class="text-3xl font-bold text-purple-600"><%= @profile.xp %></p>
      </div>
      <div class="bg-orange-50 p-4 rounded-lg text-center">
        <p class="text-sm text-gray-500 uppercase font-semibold mb-1">Streak Atual</p>
        <p class="text-3xl font-bold text-orange-600"><%= @profile.streak_days %> 🔥</p>
      </div>
      <div class="bg-green-50 p-4 rounded-lg text-center">
        <p class="text-sm text-gray-500 uppercase font-semibold mb-1">Recorde</p>
        <p class="text-3xl font-bold text-green-600"><%= @profile.max_streak %> 🏆</p>
      </div>
    </div>

    <div class="mb-2">
      <div class="flex justify-between text-sm mb-1 text-gray-600">
        <span>Progresso do Nível</span>
        <span><%= @profile.xp_progress_percentage %>%</span>
      </div>
      <div class="w-full bg-gray-200 rounded-full h-4">
        <div class="bg-blue-600 h-4 rounded-full transition-all duration-500" style="width: <%= @profile.xp_progress_percentage %>%"></div>
      </div>
      <div class="flex justify-between text-xs mt-1 text-gray-500">
        <span>XP Atual: <%= @profile.xp - GamificationProfile::LEVELS[@profile.level] %></span>
        <% if @profile.level < GamificationProfile::LEVELS.keys.max %>
          <span>Próximo Nível: <%= GamificationProfile::LEVELS[@profile.level + 1] - GamificationProfile::LEVELS[@profile.level] %></span>
        <% else %>
          <span>Nível Máximo!</span>
        <% end %>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-md p-6">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-2xl font-bold">Conquistas Recentes</h2>
      <%= link_to "Ver Todas", achievements_profile_path, class: "text-blue-600 hover:text-blue-800 text-sm font-semibold transition" %>
    </div>

    <% if @recent_achievements.any? %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <% @recent_achievements.each do |achievement| %>
          <div class="border border-green-200 bg-green-50 rounded-lg p-4 flex flex-col items-center text-center">
            <div class="text-4xl mb-2"><%= achievement.icon_url %></div>
            <h3 class="font-bold text-gray-800 mb-1"><%= achievement.name %></h3>
            <p class="text-xs text-gray-600 mb-2"><%= achievement.description %></p>
            <span class="text-xs font-bold text-green-600 bg-green-100 px-2 py-1 rounded-full"><%= achievement.xp_reward %> XP</span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500 text-center py-8">Você ainda não desbloqueou nenhuma conquista. Continue completando tarefas!</p>
    <% end %>
  </div>
</div>
