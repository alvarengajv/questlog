<%# === HEADER === %>
<div class="mb-8">
  <%= link_to profile_path, class: "back-link" do %>
    <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
    </svg>
    Perfil
  <% end %>
  <h1 class="text-3xl font-bold tracking-wide">Conquistas</h1>
  <p class="text-[var(--color-quest-gold-dim)] text-sm mt-1">
    <%= @user_achievement_ids.size %>/<%= @all_achievements.size %> desbloqueadas
  </p>
</div>

<%# === ACHIEVEMENT GRID === %>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
  <% @all_achievements.each do |achievement| %>
    <% is_unlocked = @user_achievement_ids.include?(achievement.id) %>
    <div class="<%= is_unlocked ? 'achievement-unlocked' : 'achievement-locked' %> rounded-xl p-5 flex flex-col items-center text-center transition-all">
      <div class="text-4xl mb-3 <%= is_unlocked ? '' : 'grayscale' %>" role="img" aria-label="<%= achievement.name %>">
        <%= achievement.icon_url %>
      </div>

      <h3 class="font-display font-semibold text-sm mb-1.5
        <%= is_unlocked ? 'text-[var(--color-parchment)]' : 'text-[var(--color-quest-gold-dim)]' %>">
        <%= achievement.name %>
      </h3>

      <% if is_unlocked %>
        <p class="text-xs text-[var(--color-forest-sage)] font-medium mb-2">Desbloqueada!</p>
        <span class="text-[10px] font-bold text-[var(--color-forest-sage)] bg-[rgba(122,155,90,0.12)] px-2.5 py-0.5 rounded-full">
          +<%= achievement.xp_reward %> XP
        </span>
      <% else %>
        <p class="text-[10px] text-[var(--color-quest-gold-dim)] mb-2 italic"><%= achievement.description %></p>
        <span class="text-[10px] font-bold text-[var(--color-quest-gold-dim)] bg-[rgba(201,169,110,0.08)] px-2.5 py-0.5 rounded-full">
          <%= achievement.xp_reward %> XP
        </span>
      <% end %>
    </div>
  <% end %>
</div>
