<div class="max-w-4xl mx-auto mt-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">Conquistas</h1>
    <%= link_to "Voltar ao Perfil", profile_path, class: "text-blue-600 hover:text-blue-800 transition" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @all_achievements.each do |achievement| %>
      <% is_unlocked = @user_achievement_ids.include?(achievement.id) %>
      <div class="border rounded-lg p-5 flex flex-col items-center text-center transition-all <%= is_unlocked ? 'border-green-300 bg-green-50 shadow-md' : 'border-gray-200 bg-gray-50 opacity-75' %>">
        <div class="text-5xl mb-4 <%= is_unlocked ? '' : 'filter grayscale' %>">
          <%= achievement.icon_url %>
        </div>
        
        <h3 class="font-bold text-lg mb-2 <%= is_unlocked ? 'text-green-800' : 'text-gray-600' %>">
          <%= achievement.name %>
        </h3>
        
        <% if is_unlocked %>
          <p class="text-sm text-green-700 mb-3 font-medium">Desbloqueada!</p>
          <span class="inline-block bg-green-200 text-green-800 text-xs px-3 py-1 rounded-full font-bold">
            +<%= achievement.xp_reward %> XP
          </span>
        <% else %>
          <p class="text-xs text-gray-500 mb-3 italic">
            Para desbloquear: <%= achievement.description %>
          </p>
          <span class="inline-block bg-gray-200 text-gray-600 text-xs px-3 py-1 rounded-full font-bold">
            Recompensa: <%= achievement.xp_reward %> XP
          </span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
