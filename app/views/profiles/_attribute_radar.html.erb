<% if @attribute_scores_normalized.empty? %>
  <%# Estado vazio: sem listas %>
  <div class="text-center py-8">
    <div class="text-3xl mb-2 opacity-30" role="img" aria-label="Gráfico">&#x1F4CA;</div>
    <p class="text-[var(--color-quest-gold-dim)] text-sm">Crie listas para visualizar seus atributos</p>
  </div>
<% elsif @attribute_scores_normalized.size < 3 %>
  <%# Menos de 3 listas: mostra apenas cards sem radar %>
  <div class="text-center py-8 mb-4">
    <div class="text-3xl mb-2 opacity-30" role="img" aria-label="Gráfico">&#x1F4CA;</div>
    <p class="text-[var(--color-quest-gold-dim)] text-sm">Crie ao menos 3 listas para desbloquear o gráfico radar</p>
  </div>

  <% max_score = @attribute_scores.values.max || 0 %>
  <div class="grid grid-cols-2 gap-3">
    <% @attribute_scores.each do |name, raw_score| %>
      <% normalized = @attribute_scores_normalized[name] || 0 %>
      <% color = @attribute_colors[name].presence || "var(--color-quest-gold)" %>
      <% is_top = max_score > 0 && raw_score == max_score %>
      <div class="rounded-lg p-3 bg-[rgba(28,23,18,0.5)] border <%= is_top ? 'border-[var(--color-quest-gold)]' : 'border-[rgba(201,169,110,0.1)]' %>">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background-color: <%= color %>"></span>
          <span class="text-xs font-semibold text-[var(--color-parchment)] truncate"><%= name %></span>
        </div>
        <p class="text-lg font-display font-bold text-[var(--color-quest-gold)] mb-1.5"><%= raw_score %> <span class="text-[10px] font-normal text-[var(--color-quest-gold-dim)]">pts</span></p>
        <%= render "shared/xp_progress", percentage: normalized, height_class: "h-1.5" %>
      </div>
    <% end %>
  </div>
<% else %>
  <%# Layout completo: lista à esquerda, radar à direita %>
  <% max_score = @attribute_scores.values.max || 0 %>
  <div class="flex flex-col md:flex-row gap-6">
    <%# Lista de atributos (esquerda) %>
    <div class="w-full md:w-5/12 flex flex-col justify-center gap-3">
      <% @attribute_scores.each do |name, raw_score| %>
        <% normalized = @attribute_scores_normalized[name] || 0 %>
        <% color = @attribute_colors[name].presence || "var(--color-quest-gold)" %>
        <% is_top = max_score > 0 && raw_score == max_score %>
        <div class="flex items-center gap-3 rounded-lg px-3 py-2.5 border <%= is_top ? 'border-[var(--color-quest-gold)] bg-[rgba(201,169,110,0.06)]' : 'border-[rgba(201,169,110,0.1)] bg-[rgba(28,23,18,0.5)]' %>">
          <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background-color: <%= color %>"></span>
          <span class="text-sm font-semibold text-[var(--color-parchment)] truncate flex-1"><%= name %></span>
          <span class="text-lg font-display font-bold text-[var(--color-quest-gold)] tabular-nums"><%= raw_score %></span>
          <span class="text-[10px] text-[var(--color-quest-gold-dim)]">pts</span>
        </div>
      <% end %>
    </div>

    <%# Gráfico Radar (direita) %>
    <div class="w-full md:w-7/12 flex justify-center">
      <div class="w-full max-w-[350px] relative"
           data-controller="radar-chart"
           data-radar-chart-labels-value="<%= @attribute_scores_normalized.keys.to_json %>"
           data-radar-chart-values-value="<%= @attribute_scores_normalized.values.to_json %>">
        <canvas data-radar-chart-target="canvas" width="350" height="350"></canvas>
      </div>
    </div>
  </div>
<% end %>
