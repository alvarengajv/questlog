<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "QuestLog" %></title>
    <meta name="description" content="<%= content_for(:description) || "QuestLog — Gamifique suas tarefas, suba de nível e conquiste seus objetivos." %>">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="QuestLog">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Google Fonts (preconnect + link to avoid FOUT with Turbo) %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" data-turbo-track="reload">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:rounded-md focus:bg-[var(--color-quest-gold)] focus:text-[var(--color-shadow-oak)] focus:font-semibold focus:text-sm">Pular para o conteúdo</a>
    <% if logged_in? %>
      <%# ============================================ %>
      <%# === LAYOUT WITH SIDENAV (logged in) ======= %>
      <%# ============================================ %>
      <div class="flex h-full">
        <%# === SIDENAV === %>
        <aside class="hidden md:flex flex-col w-56 flex-shrink-0 bg-[var(--color-dark-leather)] border-r border-[rgba(201,169,110,0.1)] fixed inset-y-0 left-0 z-40">
          <%# Logo %>
          <div class="px-5 py-5 border-b border-[rgba(201,169,110,0.08)]">
            <%= link_to root_path, class: "flex items-center gap-2.5 group" do %>
              <img src="/questlog_logo_w_text.svg" alt="QuestLog" class="h-8 opacity-90 group-hover:opacity-100 transition-opacity">
            <% end %>
          </div>

          <%# Gamification summary %>
          <turbo-frame id="gamification_bar">
            <% if current_user.gamification_profile %>
              <div class="px-5 py-4 border-b border-[rgba(201,169,110,0.08)]">
                <div class="flex items-center justify-between mb-2">
                  <span class="font-display text-[var(--color-xp-amber)] text-xs font-semibold tracking-wider uppercase">Lv.<%= current_user.gamification_profile.level %></span>
                  <span class="text-[var(--color-xp-amber)] text-xs font-medium"><%= streak_display(current_user.gamification_profile) %></span>
                </div>
                <div class="mb-1.5">
                  <%= render "shared/xp_progress", percentage: xp_percentage(current_user.gamification_profile) %>
                </div>
                <span class="text-[var(--color-quest-gold-dim)] text-[10px] font-medium tabular-nums"><%= current_user.gamification_profile.xp %> XP</span>
              </div>
            <% end %>
          </turbo-frame>

          <%# Navigation links %>
          <nav class="flex-1 px-3 py-4 space-y-1" aria-label="Menu principal">
            <%= link_to root_path, class: "sidenav-link #{current_page?(root_path) ? 'sidenav-link-active' : ''}", aria: { current: (current_page?(root_path) ? "page" : nil) } do %>
              <svg class="w-[18px] h-[18px]" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
              </svg>
              Quest Board
            <% end %>

            <%= link_to profile_path, class: "sidenav-link #{current_page?(profile_path) ? 'sidenav-link-active' : ''}", aria: { current: (current_page?(profile_path) ? "page" : nil) } do %>
              <svg class="w-[18px] h-[18px]" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              Perfil
            <% end %>

            <%= link_to friends_path, class: "sidenav-link #{current_page?(friends_path) ? 'sidenav-link-active' : ''}", aria: { current: (current_page?(friends_path) ? "page" : nil) } do %>
              <svg class="w-[18px] h-[18px]" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              Amigos
            <% end %>

            <%= link_to leaderboard_path, class: "sidenav-link #{current_page?(leaderboard_path) ? 'sidenav-link-active' : ''}", aria: { current: (current_page?(leaderboard_path) ? "page" : nil) } do %>
              <svg class="w-[18px] h-[18px]" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
              </svg>
              Ranking
            <% end %>
          </nav>

          <%# Bottom: Logout %>
          <div class="px-3 pb-4 mt-auto border-t border-[rgba(201,169,110,0.08)] pt-3">
            <div class="px-3 mb-3">
              <p class="text-[10px] text-[var(--color-quest-gold-dim)] truncate"><%= current_user.email %></p>
            </div>
            <%= button_to logout_path, method: :delete, class: "sidenav-link w-full text-left text-[var(--color-critical-hit)]/60 hover:text-[var(--color-critical-hit)] hover:bg-[rgba(184,76,58,0.08)]" do %>
              <svg class="w-[18px] h-[18px]" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
              </svg>
              Sair
            <% end %>
          </div>
        </aside>

        <%# === MOBILE TOP BAR === %>
        <div class="md:hidden fixed top-0 inset-x-0 z-40 border-b border-[rgba(201,169,110,0.1)] bg-[var(--color-dark-leather)]/95 backdrop-blur-md">
          <div class="flex items-center justify-between h-14 px-4">
            <%= link_to root_path, class: "flex items-center gap-2 group" do %>
              <img src="/questlog_logo_w_text.svg" alt="QuestLog" class="h-7 opacity-90">
            <% end %>
            <turbo-frame id="gamification_bar_mobile">
              <% if current_user.gamification_profile %>
                <div class="flex items-center gap-2">
                  <span class="font-display text-[var(--color-xp-amber)] text-xs font-semibold">Lv.<%= current_user.gamification_profile.level %></span>
                  <span class="text-[var(--color-quest-gold-dim)] text-[10px] tabular-nums"><%= current_user.gamification_profile.xp %> XP</span>
                </div>
              <% end %>
            </turbo-frame>
          </div>
        </div>

        <%# === MOBILE BOTTOM NAV === %>
        <nav class="fixed bottom-0 inset-x-0 z-40 border-t border-[rgba(201,169,110,0.1)] bg-[rgba(26,20,13,0.95)] backdrop-blur-md md:hidden" aria-label="Menu principal">
          <div class="flex items-center justify-around h-14">
            <%= link_to root_path, class: "bottom-nav-link #{current_page?(root_path) ? 'bottom-nav-link-active' : ''}", aria: { current: (current_page?(root_path) ? "page" : nil) } do %>
              <svg class="w-5 h-5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
              </svg>
              <span class="text-[10px] mt-0.5">Quests</span>
            <% end %>

            <%= link_to friends_path, class: "bottom-nav-link #{current_page?(friends_path) ? 'bottom-nav-link-active' : ''}", aria: { current: (current_page?(friends_path) ? "page" : nil) } do %>
              <svg class="w-5 h-5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span class="text-[10px] mt-0.5">Amigos</span>
            <% end %>

            <%= link_to leaderboard_path, class: "bottom-nav-link #{current_page?(leaderboard_path) ? 'bottom-nav-link-active' : ''}", aria: { current: (current_page?(leaderboard_path) ? "page" : nil) } do %>
              <svg class="w-5 h-5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
              </svg>
              <span class="text-[10px] mt-0.5">Ranking</span>
            <% end %>

            <%= link_to profile_path, class: "bottom-nav-link #{current_page?(profile_path) ? 'bottom-nav-link-active' : ''}", aria: { current: (current_page?(profile_path) ? "page" : nil) } do %>
              <svg class="w-5 h-5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              <span class="text-[10px] mt-0.5">Perfil</span>
            <% end %>
          </div>
        </nav>

        <%# === MAIN CONTENT === %>
        <div class="flex-1 md:ml-56">
          <main id="main-content" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pb-20 md:pb-8 mt-14 md:mt-0 page-enter">
            <%= yield %>
          </main>
        </div>
      </div>

    <% else %>
      <%# ============================================ %>
      <%# === LAYOUT WITHOUT SIDENAV (logged out) === %>
      <%# ============================================ %>
      <nav class="border-b border-[rgba(201,169,110,0.1)] bg-[var(--color-dark-leather)]/80 backdrop-blur-md sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex items-center justify-between h-14">
            <%= link_to root_path, class: "flex items-center gap-2.5 group" do %>
              <img src="/questlog_logo_w_text.svg" alt="QuestLog" class="h-8 opacity-90 group-hover:opacity-100 transition-opacity">
            <% end %>
            <div class="flex items-center gap-2">
              <%= link_to login_path, class: "text-[var(--color-aged-linen)]/60 hover:text-[var(--color-quest-gold)] transition-colors text-sm font-medium px-3 py-1.5" do %>
                Entrar
              <% end %>
              <%= link_to signup_path, class: "quest-btn text-xs py-1.5 px-4" do %>
                Criar conta
              <% end %>
            </div>
          </div>
        </div>
      </nav>

      <main id="main-content" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 page-enter">
        <%= yield %>
      </main>
    <% end %>

    <%# === NOTIFICATIONS === %>
    <div id="notifications" class="fixed top-16 right-4 z-50 space-y-2 max-w-sm w-full pointer-events-none">
    </div>

    <%# === FLASH MESSAGES === %>
    <% flash.each do |key, message| %>
      <div role="alert" class="quest-flash fixed bottom-6 right-6 z-40
        <%= key == 'notice' ? 'quest-flash-notice' : 'quest-flash-alert' %>"
        data-controller="flash" data-flash-delay-value="3000">
        <%= message %>
      </div>
    <% end %>
  </body>
</html>
