<%# === HEADER === %>
<div class="mb-8">
  <%= link_to root_path, class: "back-link" do %>
    <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
    </svg>
    Quest Board
  <% end %>
  <h1 class="text-3xl font-bold tracking-wide">Amigos</h1>
</div>

<%# === ADD FRIEND FORM === %>
<div class="quest-card p-6 mb-6">
  <h2 class="text-lg font-bold tracking-wide mb-4">Adicionar Amigo</h2>
  <%= form_with url: friends_path, method: :post, class: "flex gap-3" do |f| %>
    <input type="email" name="email" placeholder="Email do amigo" required
           class="flex-1 bg-[var(--color-dark-leather-light)] border border-[rgba(201,169,110,0.15)] rounded-lg px-4 py-2.5 text-sm text-[var(--color-parchment)] placeholder-[var(--color-quest-gold-dim)]/50 focus:outline-none focus:border-[var(--color-quest-gold-dim)] transition-colors">
    <button type="submit" class="quest-btn text-sm py-2.5 px-5">Enviar Convite</button>
  <% end %>
</div>

<%# === PENDING RECEIVED === %>
<% if @pending_received.any? %>
  <div class="quest-card p-6 mb-6">
    <h2 class="text-lg font-bold tracking-wide mb-4">Convites Recebidos</h2>
    <div class="space-y-3">
      <% @pending_received.each do |friendship| %>
        <div class="flex items-center justify-between bg-[var(--color-dark-leather-light)] rounded-lg px-4 py-3">
          <div>
            <p class="text-sm font-semibold text-[var(--color-parchment)]"><%= friendship.user.name %></p>
            <p class="text-xs text-[var(--color-quest-gold-dim)]"><%= friendship.user.email %></p>
          </div>
          <div class="flex gap-2">
            <%= button_to accept_friend_path(friendship), method: :patch, class: "quest-btn text-xs py-1.5 px-3" do %>
              Aceitar
            <% end %>
            <%= button_to friend_path(friendship), method: :delete, class: "text-xs text-[var(--color-critical-hit)]/70 hover:text-[var(--color-critical-hit)] transition-colors py-1.5 px-3" do %>
              Recusar
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<%# === PENDING SENT === %>
<% if @pending_sent.any? %>
  <div class="quest-card p-6 mb-6">
    <h2 class="text-lg font-bold tracking-wide mb-4">Convites Enviados</h2>
    <div class="space-y-3">
      <% @pending_sent.each do |friendship| %>
        <div class="flex items-center justify-between bg-[var(--color-dark-leather-light)] rounded-lg px-4 py-3">
          <div>
            <p class="text-sm font-semibold text-[var(--color-parchment)]"><%= friendship.friend.name %></p>
            <p class="text-xs text-[var(--color-quest-gold-dim)]"><%= friendship.friend.email %></p>
          </div>
          <span class="text-xs text-[var(--color-xp-amber)] font-medium">Pendente</span>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<%# === ACCEPTED FRIENDS === %>
<div class="quest-card p-6">
  <h2 class="text-lg font-bold tracking-wide mb-4">Meus Amigos</h2>
  <% if @accepted_friends.any? %>
    <div class="space-y-3">
      <% @accepted_friends.each do |friendship| %>
        <div class="flex items-center justify-between bg-[var(--color-dark-leather-light)] rounded-lg px-4 py-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[var(--color-dark-leather)] border border-[rgba(201,169,110,0.15)] flex items-center justify-center">
              <svg class="w-5 h-5 text-[var(--color-quest-gold-dim)]" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-[var(--color-parchment)]"><%= friendship.friend.name %></p>
              <p class="text-xs text-[var(--color-quest-gold-dim)]"><%= friendship.friend.email %></p>
            </div>
          </div>
          <%= button_to friend_path(friendship), method: :delete, class: "text-xs text-[var(--color-critical-hit)]/70 hover:text-[var(--color-critical-hit)] transition-colors py-1.5 px-3", data: { turbo_confirm: "Remover amizade com #{friendship.friend.name}?" } do %>
            Remover
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-8">
      <div class="text-3xl mb-2 opacity-30">&#x1F91D;</div>
      <p class="text-[var(--color-quest-gold-dim)] text-sm">Nenhum amigo ainda. Envie um convite!</p>
    </div>
  <% end %>
</div>
